# Server
NODE_ENV=development
PORT=3000
LOG_LEVEL=info

# Database
DATABASE_URL=postgresql://orchestrator:dev_password@localhost:5432/payment_orchestrator

# Simphony STS API (for tender posting)
STS_BASE_URL=https://bits-sts.oraclemicros.com/api/v1
AUTHORIZE_URL=https://ors-idm.bits.oraclerestaurants.com/oidc-provider/v1/oauth2/authorize
SIGNIN_URL=https://ors-idm.bits.oraclerestaurants.com/oidc-provider/v1/oauth2/signin
TOKEN_URL=https://ors-idm.bits.oraclerestaurants.com/oidc-provider/v1/oauth2/token
CLIENT_ID=your_client_id_here
API_USERNAME=your_username_here
API_PASSWORD=your_password_here
REDIRECT_URI=apiaccount://callback
SCOPE=openid
ORG_SHORT_NAME=your_org_short_name
LOC_REF=your_location_ref

# Simphony Default Values (required fields with fallback defaults)
SIMPHONY_DEFAULT_EMPLOYEE_REF=1
SIMPHONY_DEFAULT_ORDER_TYPE_REF=1

# Simphony Tender Posting Mode
# Set to true to use mock tender posting (for testing without real Simphony)
SIMPHONY_USE_MOCK_TENDER=false

# Gateway Selection
# Set USE_MOCK_GATEWAY=true for testing, false for real Elavon
USE_MOCK_GATEWAY=true
MOCK_FAILURE_RATE=0.1
MOCK_TIMEOUT_RATE=0.05
MOCK_LATENCY_MS=500

# Elavon Converge Gateway (used when USE_MOCK_GATEWAY=false)
# Get credentials from Elavon/Converge merchant portal
ELAVON_MERCHANT_ID=your_merchant_id_here
ELAVON_USER_ID=your_user_id_here
ELAVON_PIN=your_pin_here
# Sandbox URL (for testing):
ELAVON_CONVERGE_URL=https://api.demo.convergepay.com/VirtualMerchantDemo/processxml.do
# Production URL (for live payments):
# ELAVON_CONVERGE_URL=https://api.convergepay.com/VirtualMerchant/processxml.do
ELAVON_USE_SANDBOX=true

# Security
API_KEY=change_this_in_production
